datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // hashed
  createdAt DateTime @default(now())
  orders    Order[]
  reviews   Review[]
}

model Restaurant {
  id       String     @id @default(cuid())
  name     String
  location String
  distance Float
  rating   Float      @default(0)
  imageUrl String
  menus    MenuItem[]
  reviews  Review[]
}

model MenuItem {
  id           String      @id @default(cuid())
  title        String
  price        Float
  imageUrl     String
  type         String // "food" | "drink" | "snacks" etc
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  restaurantId String
  orders       OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime    @default(now())
  total     Float
  items     OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId String
  quantity   Int
}

model Review {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId String
  stars        Int
  text         String
  createdAt    DateTime   @default(now())
}
