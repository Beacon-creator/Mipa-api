{
  "compilerOptions": {
    // Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Module/target
    "module": "commonjs",
    "target": "ES2020",

    // Interop & node stuff
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,

    // Output
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Strictness
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "typeRoots": ["./node_modules/@types", "./src/shared/types"],

    // Others
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
